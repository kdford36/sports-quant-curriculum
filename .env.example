# Copy to .env on each machine (never commit .env).

# The Odds API key (https://the-odds-api.com)
ODDS_API_KEY=

# Where raw data pulls are stored. Point this at a cloud-synced folder
# (Google Drive for desktop, OneDrive, Dropbox) so paid pulls are made once
# and every machine sees them. Leave blank to use ./data in the repo.
# Windows example: DATA_DIR=G:/My Drive/sports-quant-data
# Mac example:     DATA_DIR=/Users/kyle/Library/CloudStorage/GoogleDrive-.../My Drive/sports-quant-data
DATA_DIR=

# Local DuckDB file. Keep it OFF the synced folder: it is rebuilt from raw
# files on each machine, and syncing a live database file can corrupt it.
DB_PATH=
